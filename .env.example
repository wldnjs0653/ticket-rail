# Application
PORT=3000
SKIP_KAFKA_CONSUMERS=false

# Local Redis (Kubernetes uses Sentinel through Deployment environment values)
REDIS_MODE=direct
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_SENTINELS=redis-sentinel.data:26379
REDIS_SENTINEL_MASTER=ticketing-master
REDIS_PASSWORD=

# PostgreSQL
PG_HOST=ticketing-postgresql-rw.data
PG_PORT=5432
PG_DATABASE=ticketing
PG_USER=ticketing_app
PG_PASSWORD=localtest

# Kafka
KAFKA_BROKERS=ticketing-kafka-kafka-bootstrap.data.svc.cluster.local:9092
KAFKA_CLIENT_ID=ticketing-backend
KAFKA_CONSUMER_GROUP=ticketing-backend-consumers
KAFKA_TOPIC_BOOKING_CREATED=booking.created
KAFKA_TOPIC_PAYMENT_REQUESTED=payment.requested
KAFKA_TOPIC_PAYMENT_COMPLETED=payment.completed
KAFKA_TOPIC_NOTIFICATION_REQUESTED=notification.requested

# Application TTL and queue settings
IDEMPOTENCY_TTL_SECONDS=86400
SEAT_HOLD_TTL_SECONDS=300
QUEUE_ADMISSION_LIMIT=200
ADMISSION_TTL_SECONDS=600
QUEUE_TOKEN_TTL_SECONDS=3900

# Optional mock behavior
MOCK_PAYMENT_FAILURE_RATE=0
