# Bash 문법. 복사 후 본인 환경에 맞게 수정합니다. 인증값은 보고서에 저장하지 않습니다.
# auto: Backend Service로 연결되는 HTTPS Ingress가 하나일 때 자동 조회
BASE_URL=auto
EVENT_ID=1
TARGET_PATH=/seats/1
NAMESPACE=app
BACKEND_NAME=backend
PROMETHEUS_URL=http://127.0.0.1:9090
PROM_STEP=15
PROM_RATE_WINDOW=1m
KUBE_CAPTURE=1
# KUBE_CAPTURE=1인 경우, 실제 Backend Pod 라벨을 지정하면 해당 구간 API 로그도 저장합니다.
# API_LOG_SELECTOR=app=backend
# API_LOG_TAIL=5000
# Let’s Encrypt 공인 인증서: 내부 Root CA 경로를 지정하지 않습니다.
# k6 호스트도 내부 DNS를 사용해야 합니다.
# AUTH_TOKEN=...

# load: 고정 요청 건수가 아니라 아래 VU/시간 동안 반복 요청합니다.
WARMUP_VUS=10
NORMAL_VUS=50
PEAK_VUS=200
SPIKE_VUS=500
RECOVERY_VUS=20
THINK_TIME_SECONDS=1
EXPECTED_STATUS_CODES=200
# 각 구간 시간 기본값은 README 참고. 자원 여건에 맞춰 VU를 먼저 낮추세요.

# queue: arrival-rate 단위는 '새 사용자/초', 전체 HTTP RPS가 아닙니다.
BASELINE_RATE=3
BOUNDARY_RATE=5
BACKLOG_RATE=10
QUEUE_SPIKE_RATE=20
PRE_ALLOCATED_VUS=100
MAX_VUS=500
QUEUE_MAX_WAIT_SECONDS=600
QUEUE_POLL_INTERVAL_SECONDS=5
QUEUE_READ_AFTER_ADMISSION=false
# 입장 정원/TTL 서버 구현이 확인된 경우에만 true로 변경합니다.
# QUEUE_READ_AFTER_ADMISSION=true
# QUEUE_ADMISSION_TTL_SECONDS=600

# e2e/concurrency는 실제 테스트 사용자와 아직 예약되지 않은 좌석이 필요합니다.
# USER_ID=101
# USER_IDS=101,102,103,104,105
# SEAT_ID=10
# SEAT_VUS=5

# 요청·응답 표본: 처음 N개 iteration만. 원문/인증 토큰은 기록하지 않습니다.
SAMPLE_ITERATIONS=1
# DB 읽기 검증. kubectl 접근 가능한 호스트에서 사용합니다.
DB_VERIFY=0
DB_NAMESPACE=data
DB_CLUSTER=ticketing-postgresql
DB_NAME=ticketing
DB_USER=postgres
DB_CONTAINER=postgres
DB_WAIT_SECONDS=120

# 감시·자동 중단 (항상 활성화, 기존 기본값 유지)
WATCH_INTERVAL=10
BASELINE_SECONDS=60
BACKEND_UNREADY_SECONDS=30
COLLECTION_FAILURE_SECONDS=60
HTTP_FAILURE_RATIO=0.01
HTTP_FAILURE_SUSTAIN_SECONDS=60
EXECUTOR_CPU_PERCENT=95
EXECUTOR_CPU_SUSTAIN_SECONDS=60
EXECUTOR_AVAILABLE_MEMORY_PERCENT=10
EXECUTOR_FREE_DISK_GIB=2
HPA_SATURATION_SECONDS=60
REQUIRED_BACKEND_READY=2
WATCH_DB=1
DATA_NAMESPACE=data
MONITORING_NAMESPACE=monitoring
# load/queue는 모든 계획 지표의 사전 수집을 기본 요구합니다.
REQUIRE_PLAN_METRICS=1
MANAGE_PROMETHEUS_FORWARD=0
